# Копируется в .env, .env в репозиторий не попадает.
# Значения читаются через os.environ; в коде их нет.

# Бот, от имени которого приходит заявка, и чат, куда она приходит.
# Нет любого из двух — заявка всё равно сохраняется в базу,
# а в лог пишется предупреждение.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секрет для подписи метки времени в форме. Не задан — берётся случайный
# на время работы процесса: подделать метку всё равно нельзя, но форма,
# открытая до перезапуска, попросит отправить ещё раз.
FORM_SECRET=

# Домен для абсолютных адресов в rel="alternate".
# Не задан — берётся из самого запроса.
SITE_ORIGIN=

# Файл базы заявок. Не задан — data/site.db. Тесты подставляют сюда
# временный файл, чтобы не трогать рабочие заявки.
LEADS_DB=
